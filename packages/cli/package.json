{
  "name": "@rocapine/community",
  "version": "0.1.0",
  "description": "CLI to install, upgrade and adopt the Rocapine Community SDK's Supabase backend (migrations, Edge Functions) into a project.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rocapine/community-sdk"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
